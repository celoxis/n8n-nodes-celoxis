{
  "compilerOptions": {
    "strict": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020", "es2022.error"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist/",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "credentials/**/*",
    "nodes/**/*",
    "lib/**/*",
    "index.js",
    "mapping.js"
  ],
  "exclude": ["dist", "node_modules"]
}
