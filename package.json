{
  "name": "n8n-nodes-celoxis",
  "version": "1.0.7",
  "description": "Celoxis integration for n8n — create, update, find, delete, and trigger on records",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "celoxis",
    "project-management"
  ],
  "license": "MIT",
  "author": {
    "name": "Celoxis",
    "email": "support@celoxis.com"
  },
  "homepage": "https://github.com/celoxis/n8n-nodes-celoxis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celoxis/n8n-nodes-celoxis.git"
  },
  "bugs": {
    "url": "https://github.com/celoxis/n8n-nodes-celoxis/issues"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:icons",
    "copy:icons": "mkdir -p dist/nodes/Celoxis && cp nodes/Celoxis/*.svg dist/nodes/Celoxis/",
    "lint": "echo 'lint via scan; use npx @n8n/scan-community-package@beta n8n-nodes-celoxis after publish'",
    "test": "npm run build && node test/operations.regression.js",
    "test:load": "npm run build && node -e \"require('./dist/nodes/Celoxis/Celoxis.node'); require('./dist/nodes/Celoxis/CeloxisTrigger.node'); require('./dist/credentials/CeloxisApi.credentials'); console.log('ok')\"",
    "prepublishOnly": "npm run build && npm run test"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CeloxisApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Celoxis/Celoxis.node.js",
      "dist/nodes/Celoxis/CeloxisTrigger.node.js"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  }
}
